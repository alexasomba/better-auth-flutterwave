{
  "include": ["**/*.ts", "**/*.tsx"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "@testing-library/jest-dom/vitest",
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "better-auth-flutterwave": ["../../src/index.ts"],
      "better-auth-flutterwave/client": ["../../src/client.ts"]
    }
  }
}
