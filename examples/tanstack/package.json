{
  "name": "tanstack-start-better-auth-flutterwave",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:unit": "vp test run",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "format": "vp fmt",
    "check": "vp fmt && vp lint --fix --no-error-on-unmatched-pattern",
    "check:ci": "vp fmt --check && vp lint --no-error-on-unmatched-pattern",
    "deploy": "npm run build && wrangler deploy",
    "wrangler:dry-run": "wrangler deploy --dry-run",
    "dev:billing": "BILLING_PERSISTENT=1 vp dev --port 3000",
    "build:billing": "BILLING_PERSISTENT=1 vp build",
    "db:billing:generate": "tsx scripts/generate-billing-schema.ts",
    "db:billing:check": "tsx scripts/generate-billing-schema.ts --check",
    "db:billing:migrate:local": "wrangler d1 migrations apply BILLING_DB --local --config wrangler.billing.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
